# Public Supabase project settings. These values are embedded in the mobile app.
# Use the project's anon/publishable key only. Never place a service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional redirect override for a development/installed app.
# Leave unset when using Expo Go; the app generates Expo Go's exp:// callback URL.
# For a development build or installed app, use:
# EXPO_PUBLIC_AUTH_REDIRECT_URL=benchlessai://auth/callback
